{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [{
        "id": "map",
        "type": "promptString",
        "description": "A map name without data/ or .lua"
    }],
    "configurations": [
        {
            "name": "Run map...",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "scriptRoots": ["${workspaceFolder}"],
            "args": ["${workspaceFolder}", "data/${input:map}.lua"]
        },
        {
            "name": "Run",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [ "${workspaceFolder}" ]
        },
        {
            "name": "Debug map...",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "scriptRoots": ["${workspaceFolder}"],
            "args": ["${workspaceFolder}", "--debug", "data/${input:map}.lua"]
        },
        {
            "name": "Debug",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "scriptRoots": ["${workspaceFolder}"],
            "args": ["${workspaceFolder}", "--debug"]
        },
    ]
}